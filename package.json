{
  "name": "samct",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-source.mjs && tsc && vite build && vite build --ssr scripts/prerender.tsx --outDir .prerender && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:report": "playwright show-report",
    "check:source": "node scripts/check-source.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e:stop": "node scripts/run-e2e-local.mjs --stop",
    "test:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "axios": "^1.15.0",
    "bootstrap": "^5.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/aos": "^3.0.8",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
