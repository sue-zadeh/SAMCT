# Vite reads this file only after copying it to .env.local.
# Keep the API same-origin; route /api and /uploads to ASP.NET Core.
VITE_API_BASE_URL=
# Set the approved production HTTPS origin only when the client confirms it.
VITE_SITE_URL=
VITE_ALLOW_INDEXING=false

# ASP.NET Core reads exported environment variables, NOT this file automatically.
# Use .NET user-secrets or the host's environment settings for real credentials.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=samct;Username=samct;Password=REPLACE_LOCALLY
AllowedHosts=localhost;127.0.0.1
DataProtection__KeyPath=/persistent/samct/keys
Storage__UploadPath=/persistent/samct/uploads
Database__AutoMigrate=false
EmailSettings__SmtpHost=
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=
EmailSettings__SmtpPassword=
EmailSettings__ToEmail=
EmailSettings__FrontendUrl=
# Security__KnownProxies__0 must be the actual trusted reverse proxy IP.
# Security__AllowedOrigins__0 is needed only for an explicitly approved same-site, cross-origin setup.
